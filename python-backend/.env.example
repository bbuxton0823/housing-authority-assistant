# =========================
# HOUSING AUTHORITY ASSISTANT
# =========================

# OpenAI Configuration (Required)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI models (defaults shown)
OPENAI_MODEL=gpt-4.1
GUARDRAIL_MODEL=gpt-4.1-mini

# Optional: RAG knowledge base vector store.
# Written automatically by `python build_rag.py` - no need to set by hand.
# VECTOR_STORE_ID=vs_...

# =========================
# TEAM REFERRAL ROUTING (Optional)
# =========================

# Where tagged [Referral][Team] emails are sent. Until SMTP is configured,
# referrals queue locally in referrals_outbox.jsonl instead.
# REFERRAL_MAILBOX=hcvinbox@yourpha.org
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourpha.org
# SMTP_PASSWORD=your_smtp_password_here
# SMTP_FROM=noreply@yourpha.org

# =========================
# VOICE CONFIGURATION (Optional)
# =========================

# ElevenLabs Text-to-Speech
# Get your API key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice (default)

# =========================
# TWILIO PHONE INTEGRATION (Optional)
# =========================

# Twilio Credentials
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number

# Webhook Base URL (your public server URL for Twilio callbacks)
WEBHOOK_BASE_URL=https://your-server.com

# Housing Authority Office Phone (for call transfers)
HOUSING_OFFICE_PHONE=+16501234567

# Phone call mode: "gather" (classic, works on any account) or "relay"
# (ConversationRelay streaming; requires Twilio's AI features addendum)
PHONE_MODE=gather

# Phone TTS engine: "elevenlabs" (via <Play>) or "polly" (Twilio built-in)
PHONE_TTS=elevenlabs

# ElevenLabs voice used in relay mode
RELAY_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# =========================
# OPTIONAL CONFIGURATIONS
# =========================

# Logging
LOG_LEVEL=INFO

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Opik observability (requires a running Opik instance)
# OPIK_ENABLE=false
# OPIK_URL=http://localhost:8080
# OPIK_WORKSPACE=housing-authority-assistant
