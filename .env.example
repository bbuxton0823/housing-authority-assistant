# ============================================
# HOUSING AUTHORITY ASSISTANT CONFIGURATION
# ============================================
# This is an example configuration file. Copy this to .env and update with your actual values.
# NEVER commit the actual .env file to version control!

# --------------------------------------------
# OpenAI API Configuration
# --------------------------------------------
# Your OpenAI API key for GPT model access
# Get your API key from: https://platform.openai.com/api-keys
# Format: sk-proj-[alphanumeric string]
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration (optional)
# Default: gpt-4-turbo-preview
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo-preview

# Maximum tokens for API responses (optional)
# Default: 2000
# Range: 1-4000 (depends on model)
OPENAI_MAX_TOKENS=2000

# Temperature for response randomness (optional)
# Default: 0.7
# Range: 0.0 (deterministic) to 2.0 (very random)
OPENAI_TEMPERATURE=0.7

# --------------------------------------------
# Application Configuration
# --------------------------------------------
# Log level for debugging
# Default: INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable detailed API logging (optional)
# Default: false
# Options: true, false
ENABLE_API_LOGGING=false

# --------------------------------------------
# API Server Configuration
# --------------------------------------------
# API server host address
# Default: 127.0.0.1 (localhost only)
# Use 0.0.0.0 to allow external connections (be cautious!)
API_HOST=127.0.0.1

# API server port
# Default: 8000
# Common alternatives: 3000, 5000, 8080
API_PORT=8000

# Enable CORS for frontend integration (optional)
# Default: true
# Set to false for production with same-origin requests
ENABLE_CORS=true

# Allowed CORS origins (optional)
# Default: http://localhost:3000
# Comma-separated list for multiple origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --------------------------------------------
# Security Configuration
# --------------------------------------------
# API rate limiting (requests per minute)
# Default: 60
# Recommended: 30-120 depending on usage
RATE_LIMIT_PER_MINUTE=60

# Enable API key validation for endpoints (optional)
# Default: false
# Set to true for production environments
ENABLE_API_AUTH=false

# Internal API key for service-to-service communication (if ENABLE_API_AUTH=true)
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# --------------------------------------------
# Feature Flags (optional)
# --------------------------------------------
# Enable Spanish language support
# Default: true
ENABLE_SPANISH_SUPPORT=true

# Enable inspection scheduling features
# Default: true
ENABLE_INSPECTION_FEATURES=true

# Enable debug mode (verbose logging, error details)
# Default: false
# WARNING: Never enable in production!
DEBUG_MODE=false

# --------------------------------------------
# External Service Configuration (optional)
# --------------------------------------------
# Database URL (if using external database)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=

# Redis URL for caching (if enabled)
# Format: redis://user:password@host:port/db
# REDIS_URL=

# --------------------------------------------
# Environment Information
# --------------------------------------------
# Current environment
# Default: development
# Options: development, staging, production
ENVIRONMENT=development

# Application version (auto-populated in CI/CD)
# APP_VERSION=1.0.0