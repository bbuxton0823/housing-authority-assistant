# ============================================
# HOUSING AUTHORITY ASSISTANT CONFIGURATION
# ============================================
# The backend reads its configuration from python-backend/.env:
#
#   cp python-backend/.env.example python-backend/.env
#
# See that file for the full list of options (OpenAI key/models, RAG
# vector store, referral email routing, ElevenLabs voice, Twilio phone).
# NEVER commit a real .env file to version control!

# --------------------------------------------
# Backend (python-backend/.env) - most common settings
# --------------------------------------------
# Required:
OPENAI_API_KEY=your_openai_api_key_here

# Optional (defaults shown):
OPENAI_MODEL=gpt-4.1
GUARDRAIL_MODEL=gpt-4.1-mini
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --------------------------------------------
# Frontend (ui/) - optional, defaults work for local dev
# --------------------------------------------
# Where the Next.js dev/prod server proxies API requests
# (see ui/next.config.mjs rewrites):
# BACKEND_URL=http://127.0.0.1:8000

# Set only if the browser should call the backend directly
# instead of going through the Next.js proxy:
# NEXT_PUBLIC_API_URL=
