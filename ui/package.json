{
  "name": "ai-travel-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:next": "npx next dev",
    "dev:server": "cd ../python-backend && python start_simple_server.py",
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:server\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "install-backend": "cd ../python-backend && pip install -r requirements.txt",
    "setup": "npm install && npm run install-backend"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.484.0",
    "motion": "^12.4.10",
    "next": "^15.2.4",
    "openai": "^4.87.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "wavtools": "^0.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "globals": "^17.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "typescript-eslint": "^8.53.1"
  }
}
